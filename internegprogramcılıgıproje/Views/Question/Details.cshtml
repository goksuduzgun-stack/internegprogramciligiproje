@model internegprogramcılıgıproje.Models.Question

@{
    ViewData["Title"] = Model.Title;
}

<div class="row justify-content-center">
    <div class="col-md-9">
        <!-- Soru Başlık & İçerik -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge bg-primary">@Model.Category?.Name</span>
                    <span class="text-muted small">@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                </div>

                <h2 class="fw-bold mb-3">@Model.Title</h2>
                <p class="fs-6 text-dark" style="white-space: pre-line;">@Model.Content</p>

                <hr />
                <div class="d-flex justify-content-between align-items-center text-muted small">
                    <div>
                        Soran: <strong>@(Model.User?.FullName ?? Model.User?.UserName)</strong>
                    </div>
                    <div>
                        <span>👁️ @Model.ViewCount Görüntülenme</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cevaplar Listesi -->
        <h4 class="fw-bold mb-3">Cevaplar (@(Model.Answers?.Count ?? 0))</h4>

        @if (Model.Answers != null && Model.Answers.Any())
        {
            foreach (var answer in Model.Answers.OrderBy(a => a.CreatedAt))
            {
                <div class="card shadow-sm border-0 mb-3 bg-light">
                    <div class="card-body p-3">
                        <p class="card-text mb-2 text-dark" style="white-space: pre-line;">@answer.Content</p>
                        <div class="d-flex justify-content-between align-items-center text-muted small">
                            <span>Cevaplayan: <strong class="text-dark">@(answer.User?.FullName ?? answer.User?.UserName)</strong></span>
                            <span>@answer.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-light border text-muted">
                Henüz bu soruya cevap yazılmamış. İlk cevabı sen yaz!
            </div>
        }

        <!-- Cevap Yazma Formu -->
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">Cevabını Paylaş</h5>

                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <form asp-action="AddAnswer" method="post">
                        <input type="hidden" name="QuestionId" value="@Model.Id" />
                        <div class="mb-3">
                            <textarea name="Content" class="form-control" rows="4" placeholder="Cevabınızı buraya yazınız..." required minlength="5"></textarea>
                        </div>
                        <button type="submit" class="btn btn-success px-4">Cevabı Gönder</button>
                    </form>
                }
                else
                {
                    <div class="alert alert-warning mb-0">
                        Cevap yazabilmek için lütfen <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="fw-bold alert-link">giriş yapın</a>.
                    </div>
                }
            </div>
        </div>
    </div>
</div>