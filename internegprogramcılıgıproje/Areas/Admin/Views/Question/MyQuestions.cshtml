@model IEnumerable<internegprogramcılıgıproje.Models.Question>

@{
    ViewData["Title"] = "Sorularım";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="fas fa-question-circle text-primary me-2"></i>Sorduğum Sorular</h2>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="fas fa-plus me-1"></i> Yeni Soru Sor
    </a>
</div>

@if (Model != null && Model.Any())
{
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Başlık</th>
                        <th>Kategori</th>
                        <th class="text-center">Cevap Sayısı</th>
                        <th>Oluşturulma Tarihi</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                                    @item.Title
                                </a>
                            </td>
                            <td><span class="badge bg-secondary">@item.Category?.Name</span></td>
                            <td class="text-center">
                                <span class="badge bg-info text-dark">@(item.Answers?.Count ?? 0)</span>
                            </td>
                            <td class="small text-muted">@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1">
                                    <i class="fas fa-edit"></i> Düzenle
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-eye"></i> İncele
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="text-center py-5 bg-light rounded shadow-sm">
        <i class="fas fa-folder-open fa-3x text-muted mb-3"></i>
        <h5>Henüz hiç soru sormadınız.</h5>
        <p class="text-muted">Aklınıza takılan bir soruyu topluluğa sorarak başlayabilirsiniz.</p>
        <a asp-action="Create" class="btn btn-primary mt-2">Hemen Soru Sor</a>
    </div>
}