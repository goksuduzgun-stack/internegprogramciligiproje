@model internegprogramcılıgıproje.Models.Question

@{
    ViewData["Title"] = "Soruyu Düzenle";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 fw-bold text-primary">Soruyu Düzenle</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-bold">Soru Başlığı</label>
                        <input asp-for="Title" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label fw-bold">Kategori</label>
                        <select asp-for="CategoryId" class="form-select" required>
                            @foreach (var cat in (IEnumerable<internegprogramcılıgıproje.Models.Category>)ViewBag.Categories)
                            {
                                <option value="@cat.Id" selected="@(cat.Id == Model.CategoryId ? "selected" : null)">@cat.Name</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Content" class="form-label fw-bold">Soru Detayı</label>
                        <textarea asp-for="Content" class="form-control" rows="6" required></textarea>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="MyQuestions" class="btn btn-secondary">İptal</a>
                        <button type="submit" class="btn btn-primary px-4">Değişiklikleri Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
