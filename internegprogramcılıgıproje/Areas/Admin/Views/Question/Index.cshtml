@model IEnumerable<internegprogramcılıgıproje.Models.Question>

@{
    ViewData["Title"] = "Soru Yönetimi";
}

<!-- Başlık -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800 font-weight-bold">Soru Denetimi ve Yönetimi</h1>
    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-sm btn-secondary shadow-sm">
        <i class="fas fa-arrow-left fa-sm mr-1"></i> Panoya Dön
    </a>
</div>

<!-- Sorular Tablosu -->
<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Tüm Sorular (@Model.Count())</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>Başlık</th>
                        <th>Kategori</th>
                        <th>Soran Kullanıcı</th>
                        <th style="width: 100px;" class="text-center">Cevap Sayısı</th>
                        <th style="width: 160px;">Tarih</th>
                        <th style="width: 170px;" class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td class="font-weight-bold text-gray-800">
                                    @item.Title
                                </td>
                                <td>
                                    <span class="badge badge-secondary px-2 py-1">@item.Category?.Name</span>
                                </td>
                                <td>
                                    <i class="fas fa-user-circle text-muted mr-1"></i>
                                    @(item.User?.FullName ?? item.User?.UserName)
                                </td>
                                <td class="text-center">
                                    <span class="badge badge-info px-2 py-1">@(item.Answers?.Count ?? 0)</span>
                                </td>
                                <td class="small text-muted">
                                    @item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </td>
                                <td class="text-center">
                                    <a asp-area="" asp-controller="Question" asp-action="Details" asp-route-id="@item.Id" target="_blank" class="btn btn-sm btn-info" title="Sitede Görüntüle">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu soruyu ve altındaki tüm cevapları kalıcı olarak silmek istediğinize emin misiniz?');">
                                        <button type="submit" class="btn btn-sm btn-danger" title="Soruyu Sil">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                Sistemde henüz kayıtlı soru bulunmuyor.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>